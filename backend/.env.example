# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-unique-random-value-of-at-least-50-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_ADMIN_URL=secure-admin/
FRONTEND_SITE_URL=http://localhost:3000
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=Raf's Souq <rafssouqgh@gmail.com>
CLOUDINARY_URL=

# Set this to the PostgreSQL connection URI supplied by the production host.
DATABASE_URL=
DJANGO_CACHE_URL=redis://127.0.0.1:6379/1
DJANGO_API_MAX_BODY_BYTES=65536
DJANGO_API_READ_RATE_LIMIT=120
DJANGO_API_WRITE_RATE_LIMIT=10
DJANGO_ADMIN_RATE_LIMIT=120

# Render automatically adds its RENDER_EXTERNAL_HOSTNAME to ALLOWED_HOSTS.
# For production, set the host/origin variables above to your real domains.
# Origins include https://; allowed hosts do not include a URL scheme.
